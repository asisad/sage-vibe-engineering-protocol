  "decisions": [
    {
      "surface": "skills/ + agents/",
      "decision": "PER_ITEM_MAPPED",
      "reason": "All canonical definitions and skill-local resources are packaged as attributed source."
    },
    {
      "surface": "commands/",
      "decision": "REFERENCE_ONLY",
      "reason": "Slash commands depend on host; reuse through selected skills, not a second SAGE lifecycle."
    },
    {
      "surface": "rules/",
      "decision": "REFERENCE_ONLY",
      "reason": "SAGE governing policies and dynamic quality gates remain authoritative."
    },
    {
      "surface": "hooks/ + scripts/",
      "decision": "INERT_SOURCE",
      "reason": "Included for inspection and dependency traceability; no automatic installation or execution."
    },
    {
      "surface": "MCP/provider manifests",
      "decision": "REFERENCE_ONLY",
      "reason": "Endpoint credentials, host compatibility and permissions are not provisioned by catalog import."
    },
    {
      "surface": "memory/orchestration/learning",
      "decision": "ADAPT_IDEAS",
      "reason": "No independent control plane or memory store is automatically installed."
    },
    {
      "surface": "translations/editor copies/assets/tests",
      "decision": "UPSTREAM_REFERENCE_ONLY",
      "reason": "Excluded duplicate/marketing/runtime-test surfaces remain individually inventoried by hash; not counted as new skills."
    }
