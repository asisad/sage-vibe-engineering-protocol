{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sage.local/schemas/v0.8/sage-agent-interface.schema.json",
  "title": "SAGE Agent-Native Interface Descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_type", "schema_version", "interface_id", "version", "capabilities", "layers", "decision", "decision_rationale", "contract", "security", "verification"],
  "properties": {
    "record_type": { "const": "agent_native_interface" },
    "schema_version": { "const": "sage-agent-interface/0.8" },
    "interface_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "capabilities": { "$ref": "#/$defs/stringList" },
    "layers": {
      "type": "object", "additionalProperties": false,
      "required": ["native_api", "callable_surface", "skill"],
      "properties": {
        "native_api": { "type": "string", "minLength": 1 },
        "bridge": { "type": ["string", "null"], "minLength": 1 },
        "callable_surface": { "enum": ["NATIVE_API", "CLI", "MCP", "CLI_AND_MCP"] },
        "skill": { "type": "string", "minLength": 1 }
      }
    },
    "decision": { "enum": ["ADOPT", "ADAPT", "BUILD"] },
    "decision_rationale": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "contract": {
      "type": "object", "additionalProperties": false,
      "required": ["input_schema_ref", "output_schema_ref", "version_handshake", "timeout_seconds", "maximum_timeout_seconds", "cancellation", "json_output", "typed_errors", "error_codes", "dry_run", "transport"],
      "properties": {
        "input_schema_ref": { "type": "string", "minLength": 1 },
        "output_schema_ref": { "type": "string", "minLength": 1 },
        "version_handshake": { "const": true },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "maximum_timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "cancellation": { "const": true },
        "json_output": { "const": true },
        "typed_errors": { "const": true },
        "error_codes": { "$ref": "#/$defs/stringList" },
        "dry_run": { "type": "boolean" },
        "transport": { "enum": ["IN_PROCESS", "STDIO", "LOCALHOST", "REMOTE"] }
      }
    },
    "security": {
      "type": "object", "additionalProperties": false,
      "required": ["side_effect_class", "scope_preserved", "permission_preserved", "authority_preserved", "evidence_preserved", "secrets_redacted", "network_authentication"],
      "properties": {
        "side_effect_class": { "enum": ["READ_ONLY", "ADAPTER_ONLY", "LOCAL_REVERSIBLE", "LOCAL_DESTRUCTIVE", "EXTERNAL_MUTATION", "SECURITY_ACTIVE"] },
        "scope_preserved": { "const": true },
        "permission_preserved": { "const": true },
        "authority_preserved": { "const": true },
        "evidence_preserved": { "const": true },
        "secrets_redacted": { "const": true },
        "network_authentication": { "enum": ["NOT_APPLICABLE", "TOKEN", "MTLS"] }
      }
    },
    "verification": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "contract", "compatibility", "smoke", "evidence_refs"],
      "properties": {
        "schema": { "const": true }, "contract": { "const": true },
        "compatibility": { "const": true }, "smoke": { "const": true },
        "evidence_refs": { "$ref": "#/$defs/stringList" }
      }
    }
  },
  "$defs": { "stringList": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } } }
}
