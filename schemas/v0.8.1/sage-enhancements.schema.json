{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sage.local/schemas/v0.8.1/sage-enhancements.schema.json",
  "title": "SAGE v0.8.1 Agentic Engineering Enhancements",
  "oneOf": [
    { "$ref": "#/$defs/ContextManifest" },
    { "$ref": "#/$defs/WorkflowProfile" },
    { "$ref": "#/$defs/SensorDescriptor" },
    { "$ref": "#/$defs/AgentEvaluationRun" },
    { "$ref": "#/$defs/AISSDFProfile" }
  ],
  "$defs": {
    "Id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$" },
    "Text": { "type": "string", "minLength": 1 },
    "List": { "type": "array", "items": { "$ref": "#/$defs/Text" }, "uniqueItems": true },
    "ContextManifest": {
      "type": "object", "required": ["kind", "manifest_id", "task_id", "entries"],
      "properties": {
        "kind": { "const": "context_manifest" }, "manifest_id": { "$ref": "#/$defs/Id" },
        "task_id": { "$ref": "#/$defs/Id" }, "entries": { "type": "array", "minItems": 1, "items": {
          "type": "object", "required": ["entry_id", "source", "authority", "freshness", "use_scope"],
          "properties": { "entry_id": { "$ref": "#/$defs/Id" }, "source": { "$ref": "#/$defs/Text" }, "version": { "$ref": "#/$defs/Text" }, "authority": { "enum": ["APPROVED", "OBSERVED", "INFERRED", "PROPOSED", "DEPRECATED"] }, "freshness": { "enum": ["CURRENT", "STALE", "UNKNOWN"] }, "sensitivity": { "enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "RESTRICTED"] }, "use_scope": { "$ref": "#/$defs/List" } },
          "additionalProperties": false
        } }
      }, "additionalProperties": false
    },
    "WorkflowProfile": {
      "type": "object", "required": ["kind", "profile_id", "stages", "gate_binding"],
      "properties": { "kind": { "const": "workflow_profile" }, "profile_id": { "$ref": "#/$defs/Id" }, "stages": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/Text" } }, "gate_binding": { "enum": ["SAGE_REQUIRED", "ADAPTER_REQUIRED"] }, "source_compatibility": { "$ref": "#/$defs/List" } },
      "additionalProperties": false
    },
    "SensorDescriptor": {
      "type": "object", "required": ["kind", "sensor_id", "class", "determinism", "privacy", "failure_semantics"],
      "properties": { "kind": { "const": "sensor_descriptor" }, "sensor_id": { "$ref": "#/$defs/Id" }, "class": { "enum": ["COMPUTATIONAL", "INFERENTIAL"] }, "determinism": { "enum": ["DETERMINISTIC", "BOUNDED_NONDETERMINISTIC", "NONDETERMINISTIC"] }, "privacy": { "enum": ["REDACTED", "MINIMAL", "FULL_BY_POLICY"] }, "failure_semantics": { "enum": ["BLOCK", "REVIEW_REQUIRED", "NON_BLOCKING"] }, "capabilities": { "$ref": "#/$defs/List" } },
      "additionalProperties": false
    },
    "AgentEvaluationRun": {
      "type": "object", "required": ["kind", "evaluation_id", "agent_id", "scenario_id", "status", "evidence_refs"],
      "properties": { "kind": { "const": "agent_evaluation_run" }, "evaluation_id": { "$ref": "#/$defs/Id" }, "agent_id": { "$ref": "#/$defs/Id" }, "scenario_id": { "$ref": "#/$defs/Id" }, "status": { "enum": ["PASS", "FAIL", "REVIEW_REQUIRED", "BLOCKED"] }, "iteration_count": { "type": "integer", "minimum": 0 }, "duration_ms": { "type": "integer", "minimum": 0 }, "cost_units": { "type": "number", "minimum": 0 }, "tool_calls": { "type": "integer", "minimum": 0 }, "evidence_refs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Id" } } },
      "additionalProperties": false
    },
    "AISSDFProfile": {
      "type": "object", "required": ["kind", "profile_id", "controls", "human_oversight"],
      "properties": { "kind": { "const": "ai_ssdf_profile" }, "profile_id": { "$ref": "#/$defs/Id" }, "controls": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Text" } }, "human_oversight": { "enum": ["REQUIRED", "RISK_PROPORTIONAL"] }, "provenance_required": { "type": "boolean" }, "secret_redaction": { "type": "boolean" } },
      "additionalProperties": false
    }
  }
}
