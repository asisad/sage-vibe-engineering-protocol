{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sage.local/schemas/extensions/sage-ruflo-approval.schema.json",
  "title": "SAGE Ruflo MCP approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "schema_version",
    "task_id",
    "authority",
    "workspace_root",
    "allowed_tools",
    "mode",
    "expires_at",
    "max_timeout_seconds"
  ],
  "properties": {
    "record_type": {
      "const": "sage_ruflo_approval"
    },
    "schema_version": {
      "const": "sage-ruflo/0.1"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "approval_id",
        "source",
        "scope"
      ],
      "properties": {
        "status": {
          "const": "GRANTED"
        },
        "approval_id": {
          "type": "string",
          "minLength": 3
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "workspace_root": {
      "type": "string",
      "minLength": 2
    },
    "allowed_tools": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_.-]{1,99}$"
      }
    },
    "mode": {
      "enum": [
        "READ_ONLY",
        "MUTATING"
      ]
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "max_timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300
    }
  }
}
