{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sage.local/schemas/v0.8.2/sage-operations.schema.json",
  "title": "SAGE v0.8.2 Production Operations Contracts",
  "oneOf": [
    { "$ref": "#/$defs/DeploymentContract" },
    { "$ref": "#/$defs/EnvironmentProfile" },
    { "$ref": "#/$defs/ServiceDependency" },
    { "$ref": "#/$defs/OperationsGate" }
  ],
  "$defs": {
    "Id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$" },
    "Text": { "type": "string", "minLength": 1 },
    "List": { "type": "array", "items": { "$ref": "#/$defs/Text" }, "uniqueItems": true },
    "DeploymentContract": {
      "type": "object", "required": ["kind", "deployment_id", "artifact_ref", "provider", "environment", "trigger", "gates", "rollback_ref"],
      "properties": {
        "kind": { "const": "deployment_contract" }, "deployment_id": { "$ref": "#/$defs/Id" }, "artifact_ref": { "$ref": "#/$defs/Text" }, "image_digest": { "$ref": "#/$defs/Text" }, "provider": { "enum": ["docker-compose", "coolify", "dokploy", "incus", "provider-neutral"] }, "environment": { "enum": ["LOCAL", "CI", "STAGING", "PRODUCTION"] }, "trigger": { "enum": ["MANUAL", "GIT_PUSH", "TAG", "SCHEDULED"] }, "gates": { "$ref": "#/$defs/List" }, "rollback_ref": { "$ref": "#/$defs/Text" }, "approval_required": { "type": "boolean" }
      }, "additionalProperties": false
    },
    "EnvironmentProfile": {
      "type": "object", "required": ["kind", "profile_id", "environment", "secret_policy", "network_policy", "approval"],
      "properties": { "kind": { "const": "environment_profile" }, "profile_id": { "$ref": "#/$defs/Id" }, "environment": { "enum": ["LOCAL", "CI", "STAGING", "PRODUCTION"] }, "secret_policy": { "enum": ["NONE", "INJECT_AT_RUNTIME", "MANAGED_SECRET_STORE"] }, "network_policy": { "enum": ["LOOPBACK_ONLY", "PRIVATE_NETWORK", "PUBLIC_INGRESS"] }, "approval": { "enum": ["NONE", "REVIEW_REQUIRED", "HUMAN_REQUIRED"] } },
      "additionalProperties": false
    },
    "ServiceDependency": {
      "type": "object", "required": ["kind", "dependency_id", "provider", "purpose", "persistence", "backup_policy", "healthcheck"],
      "properties": { "kind": { "const": "service_dependency" }, "dependency_id": { "$ref": "#/$defs/Id" }, "provider": { "enum": ["supabase", "redis", "postgres", "provider-neutral"] }, "purpose": { "$ref": "#/$defs/Text" }, "version": { "$ref": "#/$defs/Text" }, "persistence": { "enum": ["EPHEMERAL", "PERSISTENT"] }, "backup_policy": { "$ref": "#/$defs/Text" }, "healthcheck": { "$ref": "#/$defs/Text" }, "migration_required": { "type": "boolean" } },
      "additionalProperties": false
    },
    "OperationsGate": {
      "type": "object", "required": ["kind", "gate_id", "checks", "failure_action", "evidence_required"],
      "properties": { "kind": { "const": "operations_gate" }, "gate_id": { "$ref": "#/$defs/Id" }, "checks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Text" } }, "failure_action": { "enum": ["BLOCKED", "ROLLBACK_REQUIRED", "REVIEW_REQUIRED"] }, "evidence_required": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Text" } } },
      "additionalProperties": false
    }
  }
}
