{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://sage.local/integrations/sens/sage-sens.schema.json",
  "title":"SAGE / SENS integration seam 0.1 — metadata only, no activation",
  "oneOf":[{"$ref":"#/$defs/Registration"},{"$ref":"#/$defs/Config"},{"$ref":"#/$defs/Event"},{"$ref":"#/$defs/Finding"},{"$ref":"#/$defs/Registry"}],
  "$defs":{
    "Id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "Revision":{"type":"string","pattern":"^[a-f0-9]{40}$"},
    "Version":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_.+-]{0,63}$"},
    "Ids":{"type":"array","maxItems":32,"uniqueItems":true,"items":{"$ref":"#/$defs/Id"}},
    "Registry":{
      "type":"object","additionalProperties":false,"required":["record_type","schema_version","registry_id","protocol","entries","active_instances","self_activation_allowed","note"],
      "properties":{"record_type":{"const":"sens_proposal_registry"},"schema_version":{"const":"sage-sens/0.1"},"registry_id":{"$ref":"#/$defs/Id"},"protocol":{"const":"sage-sens/0.1"},"entries":{"type":"array","maxItems":128,"uniqueItems":true,"items":{"type":"string","pattern":"^registrations/[a-z0-9][a-z0-9.-]{0,63}\\.json$"}},"active_instances":{"type":"array","maxItems":0},"self_activation_allowed":{"const":false},"note":{"type":"string","maxLength":256}}
    },
    "Registration":{
      "type":"object","additionalProperties":false,
      "required":["record_type","schema_version","registration_id","sens_id","implementation_version","source_ref","protocol_versions","capabilities","approval_state","authority","auto_activate"],
      "properties":{
        "record_type":{"const":"sens_registration"},"schema_version":{"const":"sage-sens/0.1"},"registration_id":{"$ref":"#/$defs/Id"},"sens_id":{"$ref":"#/$defs/Id"},"implementation_version":{"$ref":"#/$defs/Version"},"source_ref":{"anyOf":[{"type":"null"},{"type":"string","pattern":"^https://[^\\s]+$","maxLength":512}]},
        "protocol_versions":{"type":"array","minItems":1,"maxItems":4,"uniqueItems":true,"items":{"const":"sage-sens/0.1"}},"capabilities":{"type":"array","minItems":1,"maxItems":4,"uniqueItems":true,"items":{"enum":["telemetry.receive","evidence.query","drift.analysis","impact.analysis"]}},
        "approval_state":{"const":"PROPOSED"},"authority":{"const":"OBSERVATION_ONLY"},"auto_activate":{"const":false}
      }
    },
    "Config":{
      "type":"object","additionalProperties":false,
      "required":["record_type","schema_version","mode","transport_connected","endpoint_ref","credential_ref","project_allowlist","budget","telemetry_failure","approval_gate_failure"],
      "properties":{
        "record_type":{"const":"sens_integration_config"},"schema_version":{"const":"sage-sens/0.1"},"mode":{"enum":["DISABLED","PREVIEW_ONLY"]},"transport_connected":{"const":false},
        "endpoint_ref":{"enum":[null,"env://SENS_ENDPOINT"]},"credential_ref":{"enum":[null,"env://SENS_AUTH_TOKEN"]},"project_allowlist":{"type":"array","minItems":1,"maxItems":32,"uniqueItems":true,"items":{"$ref":"#/$defs/Id"}},
        "budget":{"type":"object","additionalProperties":false,"required":["max_event_bytes","max_queue_events","max_batch_events","max_rate_per_minute","retention_seconds"],"properties":{"max_event_bytes":{"type":"integer","minimum":256,"maximum":16384},"max_queue_events":{"type":"integer","minimum":1,"maximum":4096},"max_batch_events":{"type":"integer","minimum":1,"maximum":256},"max_rate_per_minute":{"type":"integer","minimum":1,"maximum":6000},"retention_seconds":{"type":"integer","minimum":0,"maximum":86400}}},
        "telemetry_failure":{"const":"DROP_OPTIONAL_TELEMETRY"},"approval_gate_failure":{"const":"FAIL_CLOSED"}
      }
    },
    "Event":{
      "type":"object","additionalProperties":false,
      "required":["record_type","schema_version","event_id","event_type","project_id","task_id","run_id","step_id","actor_id","timestamp","source_revision","status","duration_ms","privacy_class","content_mode","evidence_refs"],
      "properties":{
        "record_type":{"const":"sage_sens_event"},"schema_version":{"const":"sage-sens/0.1"},"event_id":{"$ref":"#/$defs/Id"},"event_type":{"enum":["task.state","tool.result","build.result","test.result","technology.decision","approval.result"]},
        "project_id":{"$ref":"#/$defs/Id"},"task_id":{"$ref":"#/$defs/Id"},"run_id":{"$ref":"#/$defs/Id"},"step_id":{"$ref":"#/$defs/Id"},"actor_id":{"$ref":"#/$defs/Id"},"timestamp":{"type":"string","format":"date-time"},"source_revision":{"$ref":"#/$defs/Revision"},
        "status":{"enum":["PASS","FAIL","NOT_RUN","PLANNED","BLOCKED","REVIEW_REQUIRED"]},"duration_ms":{"type":"integer","minimum":0,"maximum":86400000},"privacy_class":{"enum":["PUBLIC","INTERNAL"]},"content_mode":{"const":"METADATA_ONLY"},"evidence_refs":{"$ref":"#/$defs/Ids"}
      }
    },
    "Finding":{
      "type":"object","additionalProperties":false,
      "required":["record_type","schema_version","finding_id","sens_id","project_id","task_id","source_revision","kind","severity","confidence","evidence_refs","suggested_review","provenance","authority","auto_execute"],
      "properties":{
        "record_type":{"const":"sens_finding"},"schema_version":{"const":"sage-sens/0.1"},"finding_id":{"$ref":"#/$defs/Id"},"sens_id":{"$ref":"#/$defs/Id"},"project_id":{"$ref":"#/$defs/Id"},"task_id":{"$ref":"#/$defs/Id"},"source_revision":{"$ref":"#/$defs/Revision"},
        "kind":{"enum":["DRIFT","ANOMALY","PERFORMANCE","MISSING_EVIDENCE"]},"severity":{"enum":["INFO","LOW","MEDIUM","HIGH","CRITICAL"]},"confidence":{"type":"number","minimum":0,"maximum":1},"evidence_refs":{"allOf":[{"$ref":"#/$defs/Ids"},{"minItems":1}]},"suggested_review":{"enum":["REVIEW_ARCHITECTURE","REVIEW_TESTS","REVIEW_SECURITY","NO_ACTION"]},
        "provenance":{"type":"object","additionalProperties":false,"required":["sensor_version","sensor_run_id","observed_at"],"properties":{"sensor_version":{"$ref":"#/$defs/Version"},"sensor_run_id":{"$ref":"#/$defs/Id"},"observed_at":{"type":"string","format":"date-time"}}},"authority":{"const":"OBSERVED"},"auto_execute":{"const":false}
      }
    }
  }
}
