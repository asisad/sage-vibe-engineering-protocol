{
  "policy_id": "sage.agentic-engineering.enhancements",
  "version": "0.8.1",
  "context": { "minimum_relevant_only": true, "reject_stale_restricted": true, "provenance_required": true },
  "workflow": { "default_stages": ["CONSTITUTION", "SPECIFY", "PLAN", "TASKS", "IMPLEMENT", "VERIFY", "CONVERGE"], "sage_gates_wrap_adapter": true, "source_compatibility": ["github/spec-kit", "gitlab/duo-foundational-flow", "bmad-method"] },
  "sensors": { "computational": ["test", "lint", "type-check", "sast"], "inferential": ["ai-review", "architecture-review", "risk-judgement"], "authority_from_sensor": false, "privacy_default": "REDACTED" },
  "evaluation": { "trajectory_required": true, "minimum_evidence_refs": 1, "max_unreviewed_iterations": 5, "regression_statuses": ["PASS", "FAIL", "REVIEW_REQUIRED", "BLOCKED"] },
  "ai_ssdf": { "human_oversight": "RISK_PROPORTIONAL", "controls": ["prompt-injection", "tool-integrity", "skill-supply-chain", "context-confidentiality", "model-config-integrity", "provenance"], "secret_redaction": true },
  "sandbox": { "required_for": ["R3", "R4", "external_live_adapter"], "optional_for": ["R2"], "skip_for": ["R0", "R1"] }
}
